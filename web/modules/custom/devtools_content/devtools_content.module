<?php

/**
 * @file
 * Runtime behavior for the DevTools glossary site.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_form_FORM_ID_alter() for the user login form.
 */
function devtools_content_form_user_login_form_alter(array &$form, FormStateInterface $form_state): void {
  $form['#submit'][] = 'devtools_content_user_login_redirect_submit';
}

/**
 * Redirects a successful login to the main page.
 */
function devtools_content_user_login_redirect_submit(array &$form, FormStateInterface $form_state): void {
  $form_state->setRedirectUrl(Url::fromRoute('<front>'));
}
